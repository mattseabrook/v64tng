#include <windows.h>
#include "resource.h"
#include "include/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION V64TNG_FILE_VERSION
 PRODUCTVERSION V64TNG_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Matthew Seabrook\0"
            VALUE "FileDescription", "v64tng game engine\0"
            VALUE "FileVersion", V64TNG_VERSION_STRING "\0"
            VALUE "InternalName", "v64tng.exe\0"
            VALUE "OriginalFilename", "v64tng.exe\0"
            VALUE "ProductName", "v64tng\0"
            VALUE "ProductVersion", V64TNG_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDB_SYSINFO_BG RCDATA "SystemInformation.png"
IDR_DEFAULT_SF2 RCDATA "sc55.sf2"

IDI_ICON1 ICON "icon.ico"

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 200, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About v64tng"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 90, 10, 64, 64
    LTEXT           "v64tng.exe - v" V64TNG_VERSION_STRING " (c) Matthew Seabrook.", IDC_STATIC, 10, 40, 180, 60
    DEFPUSHBUTTON   "OK", IDOK, 75, 150, 50, 14
END

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 292, 190
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "v64tng Config"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Window and renderer", IDC_STATIC, 6, 5, 280, 55
    CONTROL         "Fullscreen", IDC_SETTINGS_FULLSCREEN, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 18, 90, 12
    LTEXT           "Renderer:", IDC_SETTINGS_LABEL_RENDERER, 14, 39, 75, 10
    COMBOBOX        IDC_SETTINGS_RENDERER, 94, 36, 180, 55, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Music and digital audio", IDC_STATIC, 6, 64, 280, 101
    CONTROL         "Enable MIDI music", IDC_SETTINGS_MIDI_ENABLED, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 77, 105, 12
    LTEXT           "MIDI mode:", IDC_SETTINGS_LABEL_MIDI_MODE, 14, 98, 75, 10
    COMBOBOX        IDC_SETTINGS_MIDI_MODE, 94, 95, 180, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "MIDI bank:", IDC_SETTINGS_LABEL_MIDI_BANK, 14, 118, 75, 10
    EDITTEXT        IDC_SETTINGS_MIDI_BANK, 94, 115, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "MIDI volume:", IDC_SETTINGS_LABEL_MIDI_VOL, 160, 118, 58, 10
    EDITTEXT        IDC_SETTINGS_MIDI_VOLUME, 222, 115, 52, 14, ES_NUMBER | WS_TABSTOP
    CONTROL         "Enable PCM audio", IDC_SETTINGS_PCM_ENABLED, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 139, 105, 12
    LTEXT           "PCM volume:", IDC_SETTINGS_LABEL_PCM_VOL, 160, 141, 58, 10
    EDITTEXT        IDC_SETTINGS_PCM_VOLUME, 222, 138, 52, 14, ES_NUMBER | WS_TABSTOP

    DEFPUSHBUTTON   "Apply && Close", IDOK, 166, 171, 64, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 234, 171, 52, 14
END
