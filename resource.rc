#include <windows.h>
#include "resource.h"

IDB_SYSINFO_BG RCDATA "SystemInformation.png"
IDR_DEFAULT_SF2 RCDATA "sc55.sf2"

IDI_ICON1 ICON "icon.ico"

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 200, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About v64tng"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 90, 10, 64, 64
    LTEXT           "v64tng.exe - v0.1 (c) Matthew Seabrook.\n\nLorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.", IDC_STATIC, 10, 40, 180, 60
    DEFPUSHBUTTON   "OK", IDOK, 75, 150, 50, 14
END

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 300, 226
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "v64tng Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "MIDI mode:", IDC_SETTINGS_LABEL_MIDI_MODE, 12, 14, 94, 10
    COMBOBOX        IDC_SETTINGS_MIDI_MODE, 112, 11, 172, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "MIDI volume (0-100):", IDC_SETTINGS_LABEL_MIDI_VOL, 12, 39, 94, 10
    EDITTEXT        IDC_SETTINGS_MIDI_VOLUME, 112, 36, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Mouse-look sensitivity:", IDC_SETTINGS_LABEL_MLOOK, 12, 64, 94, 10
    EDITTEXT        IDC_SETTINGS_MLOOK, 112, 61, 60, 14, ES_NUMBER | WS_TABSTOP
    CONTROL         "Enable PCM audio", IDC_SETTINGS_PCM_ENABLED, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 88, 160, 12
    LTEXT           "PCM volume (0-100):", IDC_SETTINGS_LABEL_PCM_VOL, 12, 113, 94, 10
    EDITTEXT        IDC_SETTINGS_PCM_VOLUME, 112, 110, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Raycast FOV (degrees):", IDC_SETTINGS_LABEL_FOV, 12, 138, 94, 10
    EDITTEXT        IDC_SETTINGS_RAYCAST_FOV, 112, 135, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT           "Raycast supersampling:", IDC_SETTINGS_LABEL_SS, 12, 163, 94, 10
    COMBOBOX        IDC_SETTINGS_SUPERSAMPLE, 112, 160, 60, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Renderer:", IDC_SETTINGS_LABEL_RENDERER, 12, 188, 94, 10
    COMBOBOX        IDC_SETTINGS_RENDERER, 112, 185, 172, 55, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 180, 207, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 234, 207, 50, 14
END
